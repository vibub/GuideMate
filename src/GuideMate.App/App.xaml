<Application x:Class="GuideMate.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Startup="OnStartup" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#23272A" />
  <SolidColorBrush x:Key="Accent" Color="#137C66" />
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{StaticResource Ink}" /></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#F1F3F4" /><Setter Property="Foreground" Value="{StaticResource Ink}" />
   <Setter Property="Padding" Value="10,7" /><Setter Property="Margin" Value="2" /><Setter Property="MinHeight" Value="32" />
   <Setter Property="Cursor" Value="Hand" /><Setter Property="BorderThickness" Value="0" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DDECE7" /></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#B7D9CD" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ImmersiveDragHandle" TargetType="Thumb">
   <Setter Property="Width" Value="34" /><Setter Property="Height" Value="32" />
   <Setter Property="Focusable" Value="False" /><Setter Property="Background" Value="#F1F3F4" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="4">
     <TextBlock Text="&#xE759;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DDECE7" /></Trigger>
     <Trigger Property="IsDragging" Value="True"><Setter TargetName="Surface" Property="Background" Value="#B7D9CD" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7,6" /><Setter Property="BorderBrush" Value="#D7DCDE" /><Setter Property="BorderThickness" Value="1" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7,0,7" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,7,0,7" /></Style>
 </Application.Resources>
</Application>
