{
  "manifest_version": 3,
  "name": "随引 · B站登录同步",
  "version": "1.0.0",
  "description": "经本机确认将当前 Chrome 的 B站会话同步给随引。",
  "key": "",
  "permissions": ["cookies", "nativeMessaging"],
  "host_permissions": ["https://*.bilibili.com/*", "http://*.bilibili.com/*"],
  "action": {"default_popup": "popup.html"},
  "background": {"service_worker": "service-worker.js"}
}
